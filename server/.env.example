# Copiar como server/.env (NO subir .env a Git)
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Para ejecución local con npm: Postgres publicado por Docker
DATABASE_URL=postgresql://shopp_app:CAMBIAR_PASSWORD@127.0.0.1:5432/shopp
# No usar el valor por defecto en un servidor accesible desde Internet

# Solo para Docker Compose: definir una contraseña propia fuerte
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LARGA
