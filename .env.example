# Convex
# Copia este archivo como .env.local y pon la URL real de tu deployment Convex.
EXPO_PUBLIC_CONVEX_URL=https://TU_DEPLOYMENT.convex.cloud

# Proveedor actual. Cambia a "node" solo para probar el flujo JWT Node.
EXPO_PUBLIC_BACKEND_PROVIDER=convex

# Para probar Node en web desde el mismo Mac, comenta "convex" y usa:
# EXPO_PUBLIC_BACKEND_PROVIDER=node
# EXPO_PUBLIC_API_URL=http://localhost:3001
# En móvil usa la IP LAN del Mac; en producción configura HTTPS.

# Socket antiguo / Heroku
# Solo conservar si todavía usas socket.io.
# EXPO_PUBLIC_SOCKET_URL=http://localhost:3000

# npx convex env set AUTH_RESEND_KEY "re_TU_CLAVE_RESEND"
# npx convex env set AUTH_EMAIL_FROM \ "Shopp <onboarding@resend.dev>"


EXPO_PUBLIC_ACCESS_MODE=landing
# EXPO_PUBLIC_ACCESS_MODE=survey
