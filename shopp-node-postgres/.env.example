POSTGRES_DB=shopp
POSTGRES_USER=shopp_app
POSTGRES_PASSWORD=change-this-to-a-long-random-password
API_PORT=3001

# Para registro y recuperación por correo: introduce una clave privada real de Resend.
AUTH_RESEND_KEY=re_replace-with-your-private-resend-key
AUTH_EMAIL_FROM=Shopp <onboarding@resend.dev>
AUTH_CHALLENGE_SECRET=replace-with-at-least-32-random-bytes

# JWT HS256. Genera un secreto propio con: openssl rand -hex 32
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=shopp-api
AUTH_JWT_AUDIENCE=shopp-client

# Debe coincidir con CONVEX_NODE_BRIDGE_SECRET en el entorno Convex.
CONVEX_NODE_BRIDGE_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
SESSION_TTL_HOURS=168
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
TRUST_PROXY=false
