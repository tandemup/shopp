# Base y usuario que crea/usa PostgreSQL. No son secretos por sí solos.
POSTGRES_DB=shopp
POSTGRES_USER=shopp_app

# Secreto: contraseña del usuario anterior. Sustituye el ejemplo por un valor aleatorio.
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LARGA

# Puerto del equipo anfitrión; Docker lo mapea al 3000 del contenedor API.
API_PORT=3001

# Secreto privado de Resend. Necesario para enviar códigos de autenticación.
AUTH_RESEND_KEY=re_replace-with-your-private-resend-key

# Remitente autorizado de correo. Es configuración, no una clave secreta.
AUTH_EMAIL_FROM=Shopp <onboarding@resend.dev>

# Secreto aleatorio de al menos 32 caracteres para proteger códigos/desafíos.
AUTH_CHALLENGE_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS

# Secreto aleatorio de al menos 32 bytes para firmar/verificar JWT.
# Si cambia, los tokens que ya se emitieron dejarán de ser válidos.
AUTH_JWT_SECRET=CAMBIAR_POR_OTRO_SECRETO_ALEATORIO_DISTINTO

# Identificadores de los JWT; son configuración, no claves.
AUTH_JWT_ISSUER=shopp-api
AUTH_JWT_AUDIENCE=shopp-client

# Duración de sesión en horas (168 = 7 días; máximo del servidor: 720).
SESSION_TTL_HOURS=168

# Orígenes web permitidos, separados por comas.
# Añade aquí el dominio real de la app al desplegarla.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Déjalo en false salvo que la API esté detrás de un proxy de confianza.
TRUST_PROXY=false